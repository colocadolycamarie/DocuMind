# Copy this file to .env and fill in real values. Never commit .env.
# When deploying to Vercel, set these as Project Environment Variables instead.

# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection string from Neon (https://neon.tech) with the pgvector
# extension available. Neon's HTTP driver is required for serverless
# deployment (Vercel), so a plain self-hosted Postgres won't work here.
DATABASE_URL=

# Groq API key (free tier, OpenAI-compatible chat completions):
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Google Gemini API key (free tier, used only for embeddings):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel Blob token for storing uploaded files: https://vercel.com/docs/storage/vercel-blob
# Create a Blob store in your Vercel project (Storage tab) and it will be
# injected automatically in production; for local dev, copy it from
# Project Settings -> Environment Variables.
BLOB_READ_WRITE_TOKEN=

# --- Client ---
# Leave unset: in production it defaults to the same-origin "/api" (see
# vercel.json rewrites); in local dev it defaults to the local API server.
VITE_API_BASE_URL=
